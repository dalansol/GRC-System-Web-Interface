# Copia este archivo a .env y ajusta los valores. El archivo .env no se versiona.

PORT=3001
# Orígenes del frontend (separados por coma). Vite usa el 5174 si el 5173 está ocupado.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Dominios de correo corporativo autorizados para el alta de usuarios (separados por coma).
DOMINIOS_PERMITIDOS=expedite.com

# Autenticación: "entra" (Microsoft Entra ID) o "dev" (solo desarrollo local).
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Datos: "sql" (Azure SQL) o "memoria" (solo desarrollo local, se pierde al reiniciar).
DATA_MODE=memoria
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
# Solo para un SQL Server local (por ejemplo en Docker); no aplica a Azure SQL.
# SQL_PORT=1433
# SQL_TRUST_CERT=true
