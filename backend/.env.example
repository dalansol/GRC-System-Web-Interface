# Copia este archivo como backend/.env y llena los valores. El .env no se sube a git.

PORT=3000
DOMINIOS_PERMITIDOS=expedite.com

# 'dev' entra escribiendo el correo de un usuario registrado; 'entra' usa Microsoft Entra ID.
AUTH_MODE=dev
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# 'sql' usa la base de las variables DB_*; 'memoria' no necesita base (solo local).
DATA_MODE=sql
# Datos del "Session pooler" de Supabase (botón Connect del proyecto).
DB_SERVER=aws-0-us-east-1.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.<referencia-del-proyecto>
DB_PASSWORD=<contraseña>
# DB_PORT=5432
# Certificado de Supabase, para validar el del servidor (ver docs/diseno/base-de-datos.md).
DB_CA_CERT=certs/supabase-ca.crt
# Solo para un PostgreSQL local con certificado autofirmado; no arranca en producción.
# DB_TRUST_CERT=true

# Almacenamiento de evidencias: 'local' (carpeta backend/uploads, por omisión) o 'r2' (Cloudflare R2).
ALMACENAMIENTO=local
# Con 'r2': ID de la cuenta de Cloudflare, token de API de R2 (permiso "Object Read & Write") y bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
