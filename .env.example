# Copia este archivo a .env y ajusta los valores. El archivo .env no se versiona.

VITE_API_URL=http://localhost:3001

# Autenticación: "entra" (Microsoft Entra ID) o "dev" (solo desarrollo local,
# requiere que el backend corra con AUTH_MODE=dev).
VITE_AUTH_MODE=dev
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Opcional. Por omisión: api://<VITE_ENTRA_CLIENT_ID>/access_as_user
VITE_ENTRA_API_SCOPE=
